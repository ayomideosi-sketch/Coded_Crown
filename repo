/* =======================================================
   🖥 DESKTOP FIRST (Default Styles)
   Screen: 1920px and above
   ======================================================= */


/* =======================================================
   💻 LARGE LAPTOP
   1366px – 1400px
   ======================================================= */
@media (max-width: 1400px) {

    section{
        padding: 100px 8%;
    }

    .container{
        max-width: 1200px;
        margin: auto;
    }

    .projects{
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .skills{
        grid-template-columns: repeat(3,1fr);
    }

}


/* =======================================================
   💻 SMALL LAPTOP
   1024px – 1200px
   ======================================================= */
@media (max-width:1200px){

    section{
        padding:90px 6%;
    }

    .projects{
        grid-template-columns:repeat(2,1fr);
    }

    .skills{
        grid-template-columns:repeat(3,1fr);
    }

    .about-content{
        gap:40px;
    }

}


/* =======================================================
   📱 TABLET LANDSCAPE
   768px – 1024px
   ======================================================= */
@media (max-width:1024px){

    .projects{
        grid-template-columns:repeat(2,1fr);
    }

    .skills{
        grid-template-columns:repeat(2,1fr);
    }

    .about-content{
        display:grid;
        grid-template-columns:1fr;
        gap:50px;
    }

    .about-right img{
        width:70%;
        margin:auto;
        display:block;
    }

}



/* =======================================================
   📱 LARGE PHONES
   390px – 430px
   ======================================================= */
@media (max-width:430px){

    html{
        font-size:15px;
    }

    section{
        padding:80px 20px;
    }

    h2{
        font-size:2rem;
    }

    .hero-content h1{
        font-size:2rem;
    }

    .hero-content p{
        font-size:.95rem;
    }

    .card{
        width:100%;
    }

    .project-link a{
        display:block;
        width:100%;
        padding:12px;
        text-align:center;
    }

}


/* =======================================================
   📱 MEDIUM PHONES
   360px – 390px
   ======================================================= */
@media (max-width:390px){

    html{
        font-size:14px;
    }

    .logo{
        font-size:1.2rem;
    }

    .btn{
        width:100%;
    }

    .btn1{
        width:100%;
    }

    .hero-content h1{
        font-size:1.8rem;
    }

}


/* =======================================================
   📱 SMALL PHONES
   320px – 360px
   ======================================================= */
@media (max-width:360px){

    section{
        padding:70px 15px;
    }

    .hero-content h1{
        font-size:1.6rem;
    }

    .hero-content h2{
        font-size:1.1rem;
    }

    .card{
        padding:15px;
    }

    .tech-stack{
        flex-wrap:wrap;
        gap:8px;
    }

}


/* =======================================================
   📱 VERY SMALL PHONES
   320px
   ======================================================= */
@media (max-width:320px){

    html{
        font-size:13px;
    }

    .hero-content h1{
        font-size:1.4rem;
    }

    .btn,
    .btn1{
        padding:10px;
    }

    .logo{
        font-size:1rem;
    }

}